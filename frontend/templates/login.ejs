<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Abhishek Yadav</title>
    <meta
      name="description"
      content="Sign in to Abhishek Yadav's portfolio with Google authentication."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318181b'/%3E%3Ctext x='50%25' y='57%25' text-anchor='middle' font-size='30' font-family='Arial,sans-serif' font-weight='800' fill='white'%3EA%3C/text%3E%3C/svg%3E"
    />
    <link rel="stylesheet" href="/static/styles/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body>
    {{template "navbar" .Navbar}}

    <main class="container auth-page">
      <section class="auth-panel" aria-labelledby="login-title">
        <div class="auth-copy">
          <p class="auth-kicker">Secure access</p>
          <h1 id="login-title">Sign in to continue</h1>
          <p>
            Use your Google account to create a persistent session for this
            browser.
          </p>
        </div>

        <a class="google-login-button" href="/google_login">
          <i class="fa-brands fa-google" aria-hidden="true"></i>
          <span>Continue with Google</span>
        </a>
      </section>
    </main>

    {{template "footer" .Footer}}
  </body>
</html>

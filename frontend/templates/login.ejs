<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Iosevka+Charon:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Abhishek Yadav</title>
    <meta
      name="description"
      content="Sign in to Abhishek Yadav's portfolio with Google authentication."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318181b'/%3E%3Ctext x='50%25' y='57%25' text-anchor='middle' font-size='30' font-family='Arial,sans-serif' font-weight='800' fill='white'%3EA%3C/text%3E%3C/svg%3E"
    />
    <link rel="stylesheet" href="/static/styles/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body>
    {{template "navbar" .Navbar}}

    <main class="container auth-page">
      <section class="auth-shell" aria-labelledby="login-title">
        <div class="auth-panel auth-panel-main">
          <p class="auth-kicker">Welcome back</p>
          <h1 id="login-title">Sign in</h1>
          <p class="auth-lede">
            Use your Google account to continue to your profile.
          </p>

          <a class="google-login-button" href="/google_login">
            <i class="fa-brands fa-google" aria-hidden="true"></i>
            <span>Continue with Google</span>
          </a>
        </div>

        <aside class="auth-panel auth-side-panel" aria-label="Account summary">
          <div class="auth-mini-profile">
            <div class="auth-avatar-mark">A</div>
            <div>
              <p>Abhishek Yadav</p>
              <span>Fullstack & AI Systems Engineer</span>
            </div>
          </div>

          <ul class="auth-check-list">
            <li>
              <i class="fa-solid fa-user" aria-hidden="true"></i>
              Personal profile
            </li>
            <li>
              <i class="fa-brands fa-google" aria-hidden="true"></i>
              Google sign-in
            </li>
            <li>
              <i class="fa-solid fa-id-card" aria-hidden="true"></i>
              Account details
            </li>
          </ul>
        </aside>
      </section>
    </main>

    {{template "footer" .Footer}}
  </body>
</html>
